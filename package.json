{
  "name": "dsh-feishu-plugin",
  "version": "0.4.7",
  "private": false,
  "description": "Feishu/Lark bridge for DeepSeek Harness (dsh): one Feishu topic = one dsh session, in-card approvals and questions, streaming cards, model and permission switching, Web settings page, long connection with no public endpoint.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "feishu",
    "lark",
    "larksuite",
    "飞书",
    "飞书机器人",
    "im-bot",
    "chatbot",
    "ai-agent",
    "coding-agent",
    "approval"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyuanhua/dsh-feishu-plugin.git"
  },
  "homepage": "https://github.com/moyuanhua/dsh-feishu-plugin#readme",
  "bugs": {
    "url": "https://github.com/moyuanhua/dsh-feishu-plugin/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf lib",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "esbuild": "0.25.10"
  }
}
